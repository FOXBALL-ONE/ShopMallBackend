# ShopMall 环境变量模板
#
# 使用方式：复制为项目根目录的 .env，再按部署环境填写真实值：
#   Copy-Item .env.example .env       (PowerShell)
#   cp .env.example .env              (Linux/macOS)
#
# 解析规则：
# - 每行一个 KEY=VALUE；不要写 `export` 前缀。
# - 注释必须单独占一行；值中包含 #、空格或特殊字符时按 Spring Boot
#   properties 规则处理，最稳妥的做法是使用不含空格的随机值。
# - application.yaml 会通过 optional:file:.env[.properties] 加载本文件。
# - OS/Docker/Kubernetes 环境变量优先于 .env；未设置的变量使用 application.yaml 默认值。
# - 本文件可以提交；.env 只保存真实密钥，禁止提交。

# ============================================================================
# 数据库 PostgreSQL
# ============================================================================
# JDBC 连接串。生产环境建议使用 TLS（例如追加 ?sslmode=require），并使用独立数据库。
DB_URL=jdbc:postgresql://localhost:5432/shopmall
# 数据库登录用户名。不要使用超级用户作为生产应用账号。
DB_USERNAME=postgres
# 数据库密码。生产必须替换，建议通过密钥管理系统注入而不是写入磁盘。
DB_PASSWORD=postgres
# Hibernate DDL：update=开发自动建表；validate=生产校验；none=完全不由 Hibernate 管理。
DB_DDL=update

# ============================================================================
# 初始化与演示数据
# ============================================================================
# 空库首次部署时是否初始化统一商品元数据（类型、属性定义、基础分类）。
# 初始化完成后建议关闭，避免每次启动重复执行初始化逻辑。
PRODUCT_METADATA_INITIALIZATION_ENABLED=false
# 是否在应用启动后写入一套幂等的本地演示数据。生产必须保持 false。
MOCK_DATA_ENABLED=false
# 演示账号共用的明文密码，仅用于本地初始化；落库前会被哈希。
MOCK_DATA_PASSWORD=MockData123!

# ============================================================================
# Redis
# ============================================================================
# Redis 连接地址。Redis database 固定使用 application.yaml 中的逻辑库 7。
REDIS_HOST=localhost
REDIS_PORT=6379
# 无密码时留空；生产 Redis 必须启用认证/TLS，并限制网络访问范围。
REDIS_PASSWORD=
# 启动时是否执行 FLUSHDB。只用于一次性的本地/测试数据重置；生产必须为 false。
# 清空会删除 refresh token、限流状态、幂等键、订单 Outbox Stream 和消费组。
REDIS_CLEAR_ON_STARTUP=false

# ============================================================================
# 全局 API 限流
# ============================================================================
# 运行时总开关。关闭会停用限流逻辑，生产建议保持 true。
RATE_LIMIT_ENABLED=true
# 部署级过滤器开关。false 会完全不注册限流过滤器，仅用于测试或紧急排障。
RATE_LIMIT_FILTER_ENABLED=true
# 已认证用户每分钟默认请求数。管理端可通过运行时设置覆盖默认值。
RATE_LIMIT_AUTHENTICATED_REQUESTS_PER_MINUTE=10
# 匿名请求每分钟默认请求数。管理端可通过运行时设置覆盖默认值。
RATE_LIMIT_ANONYMOUS_REQUESTS_PER_MINUTE=5
# 用于匿名身份哈希的独立密钥，至少 32 个字符；必须与 JWT_SECRET 不同。
# 系统不会记录原始匿名 IP，密钥轮换会使已有匿名限流身份失效。
RATE_LIMIT_IDENTITY_HASH_SECRET=replace-with-a-long-random-rate-limit-identity-secret

# ============================================================================
# JWT 双 Token 认证（Access + Refresh）
# ============================================================================
# HS256 签名密钥。生产必须替换为高熵随机值，并在所有应用节点保持一致。
JWT_SECRET=dev-secret-do-not-use-in-prod-please-override-via-JWT_SECRET
# Access Token 有效期，单位秒；默认 1800 秒（30 分钟）。
JWT_ACCESS_TTL_SECONDS=1800
# Refresh Token 有效期，单位秒；默认 604800 秒（7 天），状态保存在 Redis。
JWT_REFRESH_TTL_SECONDS=604800
# true：刷新时轮换 refresh token 并作废旧 token（推荐）；false：只更新 access token。
JWT_REFRESH_ROTATE=true
# true：检测超出 grace 窗口或跨 User-Agent 的 refresh token 重放并撤销 token 家族。
JWT_REFRESH_REUSE_DETECT=true
# 已使用 refresh token 的并发重试宽限窗口，单位秒；默认 30 秒。
JWT_REFRESH_GRACE_SECONDS=30
# Refresh Cookie 名称。
JWT_REFRESH_COOKIE_NAME=refresh_token
# Cookie Domain。留空表示当前主机；同注册域多子域共享时可填 .example.com。
JWT_REFRESH_COOKIE_DOMAIN=
# Cookie Path。默认只发送到认证接口，减少 token 暴露面。
JWT_REFRESH_COOKIE_PATH=/api/auth
# 生产 HTTPS 必须为 true；本地使用 http://localhost 调试时设为 false，否则浏览器不会回传。
JWT_REFRESH_COOKIE_SECURE=true
# 防止 JavaScript 读取 refresh token，生产必须保持 true。
JWT_REFRESH_COOKIE_HTTP_ONLY=true
# 同注册域通常使用 Lax；跨注册域必须使用 None，并同时满足 Secure=true。
JWT_REFRESH_COOKIE_SAME_SITE=Lax

# ============================================================================
# 开发固定令牌（仅本地调试）
# ============================================================================
# true 时生成一张固定 JWT 并绑定默认管理员，便于 curl/Postman 调试；生产绝不能开启。
DEV_FIXED_TOKEN_ENABLED=false
# 固定令牌 jti，必须是合法 UUID；修改后重启即可轮换固定令牌。
DEV_FIXED_TOKEN_JTI=[REDACTED]-[REDACTED]
# 固定令牌有效期，单位秒；默认约 10 年，仅适合本地环境。
DEV_FIXED_TOKEN_TTL_SECONDS=315360000
# 开启固定令牌时确保存在的默认管理员用户名。
DEV_ADMIN_USERNAME=admin
# 默认管理员明文密码，仅用于本地；启动时会哈希后落库，生产不要使用默认值。
DEV_ADMIN_PASSWORD=admin
# 默认管理员邮箱；本地可使用占位值，生产应使用真实且唯一的邮箱。
DEV_ADMIN_EMAIL=admin

# ============================================================================
# 邮件 SMTP、邮箱验证与密码重置
# ============================================================================
# SMTP 主机。留空时邮件功能不可用，但应用仍可启动。
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 发件人地址；留空时回退到 MAIL_USERNAME。
MAIL_FROM=
# 邮箱验证码参数当前使用代码内默认值（5 分钟有效、60 秒发送间隔、每日 10 次、最多 5 次失败、
# 单 IP 每小时 30 次、6 位数字验证码）；如需部署级调整，应修改对应 ConfigurationProperties，而不是填写未接入的环境变量。
# 密码重置链接固定有效 300 秒，应用会校验该值，不建议修改。
PASSWORD_RESET_TTL_SECONDS=300
# 同一账号请求密码重置邮件的最小间隔，单位秒。
PASSWORD_RESET_SEND_INTERVAL_SECONDS=60
PASSWORD_RESET_MAIL_SUBJECT_PREFIX=PELISSA
# 密码重置和 Stripe Checkout 回跳的客户站点地址；生产必须 HTTPS。
STOREFRONT_BASE_URL=http://localhost:8088
# 订单支付成功邮件主题前缀。
ORDER_MAIL_SUBJECT_PREFIX=PELISSA

# ============================================================================
# 文件存储与签名下载链接
# ============================================================================
# 上传文件在服务端的存储目录；多实例部署时必须使用共享存储或统一挂载卷。
FILE_STORAGE_PATH=./storage
# 文件下载链接使用的公开基地址；生产应使用实际 API 域名并启用 HTTPS。
FILE_BASE_URL=http://localhost:8080
# HMAC 签名密钥，生产必须替换为至少 32 字符的随机值。
FILE_SIGNING_SECRET=dev-file-signing-secret-do-not-use-in-prod
# 兼容旧配置的默认用户下载链接有效期，单位秒。
FILE_DOWNLOAD_LINK_TTL_SECONDS=300
# 单次批量文件操作最多处理的文件数量。
FILE_MAX_BATCH_SIZE=20
# 单文件字节上限；必须不超过 FILE_MAX_FILE_SIZE 对应的 Multipart 限制。
FILE_MAX_FILE_SIZE_BYTES=104857600
# 按访问范围区分的签名链接有效期，单位秒：公开、普通用户、管理员、订单附件。
FILE_SIGN_PUBLIC_TTL=60
FILE_SIGN_USER_TTL=300
FILE_SIGN_ADMIN_TTL=180
FILE_SIGN_ORDER_TTL=300
# Spring Multipart 单文件上限，支持 100MB、1GB 等 DataSize 写法。
FILE_MAX_FILE_SIZE=100MB
# Spring Multipart 单次请求上限，必须大于单文件上限并覆盖多文件请求开销。
FILE_MAX_REQUEST_SIZE=500MB

# ============================================================================
# 应用日志
# ============================================================================
# 多实例部署时每个节点应使用独立且持久化的目录，禁止多个进程写同一日志根目录。
LOG_STORAGE_PATH=./logs
LOG_TIME_ZONE=Asia/Shanghai
# 节点标识，用于管理端区分日志来源；集群内必须唯一且长度不超过 100。
LOG_INSTANCE_ID=local
# 日志文件保留天数，范围 1-3650。
LOG_RETENTION_DAYS=30
# 内存实时日志缓冲区容量（条数/字节）。
LOG_LIVE_BUFFER_EVENTS=5000
LOG_LIVE_BUFFER_BYTES=16777216
# 单次实时日志响应的最大字节数。
LOG_LIVE_RESPONSE_BYTES=2097152
# 实时日志批量窗口，单位毫秒；越小延迟越低，吞吐越差。
LOG_LIVE_BATCH_WINDOW_MILLIS=100
# 管理端实时日志轮询上限。
LOG_LIVE_MAX_NODE_POLLS=50
LOG_LIVE_MAX_ADMIN_POLLS=2
# 异步日志和文件写入队列容量；增大可承受突发流量，但会增加内存占用。
LOG_ASYNC_QUEUE_EVENTS=4096
LOG_ASYNC_QUEUE_BYTES=33554432
LOG_FILE_QUEUE_EVENTS=4096
LOG_FILE_QUEUE_BYTES=33554432
# 文件写入批量大小、刷新间隔和失败退避，时间单位均为毫秒。
LOG_FILE_BATCH_EVENTS=128
LOG_FILE_FLUSH_INTERVAL_MILLIS=100
LOG_FILE_FAILURE_BACKOFF_MILLIS=1000
# 应用关闭时等待日志队列排空的最长时间，单位毫秒。
LOG_SHUTDOWN_TIMEOUT_MILLIS=5000
# 日志文件与内存缓冲对账周期，单位毫秒。
LOG_RECONCILE_INTERVAL_MILLIS=5000
# true 时日志文件不可写会使应用失败，避免静默丢日志；生产建议保持 true。
LOG_FAIL_ON_FILE_ERROR=true
# 根日志级别，例如 TRACE、DEBUG、INFO、WARN、ERROR。
LOG_ROOT_LEVEL=INFO

# ============================================================================
# Web 服务
# ============================================================================
# Spring Boot HTTP 监听端口；反向代理部署时通常监听内网端口。
SERVER_PORT=8080

# ============================================================================
# 公告与首页推荐
# ============================================================================
# 公告时间解释所使用的时区，例如 Asia/Shanghai、UTC。
ANNOUNCEMENT_TIME_ZONE=Asia/Shanghai
# 首页推荐生命周期任务使用的时区。
HOME_RECOMMENDATION_TIME_ZONE=Asia/Shanghai
# 首页推荐 Redis 缓存有效期，单位秒。
HOME_RECOMMENDATION_CACHE_TTL_SECONDS=60
# 首页推荐生命周期扫描间隔，单位毫秒。
HOME_RECOMMENDATION_LIFECYCLE_DELAY_MS=60000

# ============================================================================
# 物流、Webhook 与轮询
# ============================================================================
# 物流供应商 Webhook 请求体大小上限，单位字节。
LOGISTICS_WEBHOOK_MAX_BODY_BYTES=1048576
# 是否启用自动轮询；关闭后仍可使用 Webhook 和手动查询。
LOGISTICS_POLLING_ENABLED=true
# 首次轮询延迟，单位秒；默认 15 分钟。
LOGISTICS_POLL_INITIAL_DELAY=900
# 轮询退避的最大间隔，单位秒；默认 6 小时。
LOGISTICS_POLL_MAX_DELAY=21600
# 轮询租约有效期，单位秒；多实例必须连接同一 Redis。
LOGISTICS_POLL_LEASE_SECONDS=120
# 连续失败多少次后停止/降级该运单的自动跟踪。
LOGISTICS_TRACK_MAX_CONSECUTIVE_FAILURES=5
# 超过该天数的未完成配送被视为陈旧，单位天。
LOGISTICS_STALE_DELIVERY_DAYS=30
# 原始轨迹数据保留天数，单位天。
LOGISTICS_RAW_TRACK_RETENTION_DAYS=30
# 轮询调度器扫描间隔，单位毫秒。
LOGISTICS_POLL_SCHEDULER_DELAY_MS=60000
# 物流数据对账扫描间隔，单位毫秒。
LOGISTICS_RECONCILIATION_DELAY_MS=60000
# 各供应商默认关闭。开启任一供应商时，必须同时填写该供应商的 Webhook 密钥和 API Key。
CARRIER_4PX_ENABLED=false
CARRIER_4PX_WEBHOOK_SECRET=
CARRIER_4PX_API_KEY=
CARRIER_YUN_ENABLED=false
CARRIER_YUN_WEBHOOK_SECRET=
CARRIER_YUN_API_KEY=
CARRIER_17TRACK_ENABLED=false
CARRIER_17TRACK_WEBHOOK_SECRET=
CARRIER_17TRACK_API_KEY=

# ============================================================================
# 客服工单与附件配额
# ============================================================================
# 单个客户在创建限流窗口内最多创建的工单数及窗口（秒）。
SUPPORT_TICKET_CREATE_RATE_LIMIT=5
SUPPORT_TICKET_CREATE_RATE_WINDOW_SECONDS=600
# 单个发送者在单个工单内的消息发送上限及窗口（秒）。
SUPPORT_TICKET_MESSAGE_RATE_LIMIT=30
SUPPORT_TICKET_MESSAGE_RATE_WINDOW_SECONDS=60
# 工单幂等记录在 Redis 中的保留时间，单位秒。
SUPPORT_TICKET_IDEMPOTENCY_TTL_SECONDS=900
# 单条消息最多附件数和附件总字节数。
SUPPORT_TICKET_MAX_FILES_PER_MESSAGE=10
SUPPORT_TICKET_MAX_ATTACHMENT_BYTES_PER_MESSAGE=52428800
# 在 Multipart 解析前按 Content-Length 拦截的请求体上限。
SUPPORT_TICKET_MAX_MESSAGE_REQUEST_BYTES=62914560
# 单个工单的附件数量/字节配额。
SUPPORT_TICKET_MAX_ATTACHMENTS_PER_TICKET=100
SUPPORT_TICKET_MAX_ATTACHMENT_BYTES_PER_TICKET=536870912
# 单个客户的全部工单附件数量/字节配额。
SUPPORT_TICKET_MAX_ATTACHMENTS_PER_CUSTOMER=500
SUPPORT_TICKET_MAX_ATTACHMENT_BYTES_PER_CUSTOMER=2147483648

# ============================================================================
# 订单、Outbox 与 Stripe
# ============================================================================
# 待支付订单超时时间，单位分钟；应用约束为 30 分钟至 24 小时。
ORDER_PAYMENT_TIMEOUT_MINUTES=30
# 订单创建/支付相关 Redis 幂等记录 TTL，单位秒。
ORDER_IDEMPOTENCY_TTL=600
# Redis Stream 最大长度；过小可能过早裁剪尚未恢复的事件。
ORDER_STREAM_MAX_LEN=10000
# Outbox Relay/Consumer 失败达到该次数后进入死信/重放状态。
ORDER_OUTBOX_MAX_ATTEMPTS=5
# Outbox 事件处于 SENT 状态超过该秒数后允许重新投递。
ORDER_OUTBOX_ACK_SLA=300
# 已确认 Outbox 事件保留天数，便于审计和问题排查。
ORDER_OUTBOX_RETENTION_DAYS=7
# 单个 SKU 单次下单最大数量，应用默认上限 99。
ORDER_SINGLE_SKU_LIMIT=99
# 同一客户连续创建订单的滚动窗口，单位分钟。
ORDER_CREATION_WINDOW_MINUTES=10
# 服务端签发订单幂等键的有效期，单位分钟；通常与创建窗口保持一致。
ORDER_KEY_TTL_MINUTES=10
# Stripe Publishable Key，可安全用于前端初始化；生产使用 live key。
STRIPE_PUBLIC_KEY=
# Stripe Secret Key，只能在后端使用；建议使用 restricted key，并通过密钥管理系统注入。
STRIPE_SECRET_KEY=
# Stripe Dashboard Webhook Signing Secret，通常以 whsec_ 开头；必须与当前端点匹配。
STRIPE_WEBHOOK_SECRET=
# Webhook 最大请求体，单位字节；过小会拒绝合法事件，过大增加内存压力。
STRIPE_WEBHOOK_MAX_BODY_BYTES=262144
# Stripe Dashboard 登记的独立回调地址。路径必须是 /webhook；生产必须 HTTPS。
STRIPE_WEBHOOK_URL=https://api.example.com/webhook
# 兼容历史 Snapshot 配置：仅当新变量未设置时作为回退来源。
WEBHOOK_SECRET_SNAPSHOT=
WEBHOOK_SECRET_SNAPSHOT_URL=
WEBHOOK_SECRET_LITE=
WEBHOOK_SECRET_LITE_URL=

# ============================================================================
# 生产部署检查清单（不要把上面的示例值原样部署）
# ============================================================================
# 1. DB_DDL 使用 validate 或 none，并提前完成数据库结构管理。
# 2. 替换 JWT_SECRET、FILE_SIGNING_SECRET、RATE_LIMIT_IDENTITY_HASH_SECRET 及所有第三方密钥。
# 3. DEV_FIXED_TOKEN_ENABLED、MOCK_DATA_ENABLED、REDIS_CLEAR_ON_STARTUP 保持 false。
# 4. JWT_REFRESH_COOKIE_SECURE=true；跨站部署时核对 SameSite=None、HTTPS 和 Cookie Domain。
# 5. 配置真实 STOREFRONT_BASE_URL、STRIPE_WEBHOOK_URL，并在 Stripe Dashboard 配置签名密钥。
# 6. 多实例共享 Redis、数据库和必要的文件存储；LOG_INSTANCE_ID 为每个节点设置唯一值。
