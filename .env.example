# 复制本文件为 .env 并填入真实值；.env 不会提交到 git（见 .gitignore）。
# 格式：纯 KEY=VALUE，每行一条；# 开头为注释。
# 注意：按 properties 格式解析，请勿使用 `export` 前缀或行内注释（值含 # 时请把注释另起一行）。
# 未设置的项回退到 application.yaml 中的默认值；OS 环境变量优先级高于 .env。

# ===== 数据库 (PostgreSQL) =====
# 需先在 Postgres 中创建对应数据库（如 shopmall）
DB_URL=jdbc:postgresql://localhost:5432/shopmall
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Hibernate DDL: update(开发自动建表) / validate(生产校验) / none
DB_DDL=update

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# 启动时是否清空 Redis（本地/测试用，生产请设 false）
REDIS_CLEAR_ON_STARTUP=true

# ===== JWT（双 Token：Access + Refresh）=====
# 生产环境务必覆盖为一个足够长的随机串；access 与 refresh 共用同一密钥，以 typ claim 区分
JWT_SECRET=dev-secret-do-not-use-in-prod-please-override-via-JWT_SECRET
# 访问令牌有效期（秒），默认 30 分钟
JWT_ACCESS_TTL_SECONDS=1800
# 刷新令牌有效期（秒），默认 7 天
JWT_REFRESH_TTL_SECONDS=604800
# 每次刷新签发新 refresh 并作废旧 token（推荐 true）；false=刷新只换 access（复用检测失效）
JWT_REFRESH_ROTATE=true
# 超 grace / 跨 UA 的 USED 再现即撤销整族（推荐 true）
JWT_REFRESH_REUSE_DETECT=true
# USED token 在此窗口（秒）内再现视为合法重试，窗口外才判被盗
JWT_REFRESH_GRACE_SECONDS=30
# 刷新 Cookie 传输：本地 http 调试必须设 false，否则浏览器不回传 cookie（最易踩的坑）
JWT_REFRESH_COOKIE_SECURE=true
# 同注册域=Lax；跨注册域（不同 eTLD+1）必须 None（且 SECURE=true）
JWT_REFRESH_COOKIE_SAME_SITE=Lax

# ===== 开发固定令牌（仅本地调试，生产切勿开启）=====
# 开启后可用一张固定 JWT 免登录调试；令牌字符串在启动日志中打印
DEV_FIXED_TOKEN_ENABLED=false
# 固定令牌的 jti；生成端与识别端读同一值，轮换时改它即可（合法 UUID）
DEV_FIXED_TOKEN_JTI=00000000-0000-0000-0000-000000000000
# 有效期（秒），默认 10 年
DEV_FIXED_TOKEN_TTL_SECONDS=315360000
# 默认管理员（开启 DEV_FIXED_TOKEN_ENABLED 后每次启动确保存在，令牌绑定到该账号）
DEV_ADMIN_USERNAME=admin
# 明文密码，存储前会哈希；仅用于本地默认账号
DEV_ADMIN_PASSWORD=admin
DEV_ADMIN_EMAIL=admin

# ===== 邮件 (SMTP，用于邮箱验证) =====
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 发件人地址，留空则回退到 MAIL_USERNAME
MAIL_FROM=

# ===== 文件存储 =====
FILE_STORAGE_PATH=./storage
FILE_BASE_URL=http://localhost:8080
FILE_SIGNING_SECRET=dev-file-signing-secret-do-not-use-in-prod
FILE_DOWNLOAD_LINK_TTL_SECONDS=300
FILE_MAX_BATCH_SIZE=20
FILE_MAX_FILE_SIZE_BYTES=104857600
FILE_MAX_FILE_SIZE=100MB
FILE_MAX_REQUEST_SIZE=500MB

# ===== Web =====
SERVER_PORT=8080

# ===== 物流 =====
LOGISTICS_WEBHOOK_MAX_BODY_BYTES=1048576
LOGISTICS_POLL_INITIAL_DELAY=900
LOGISTICS_POLL_MAX_DELAY=21600
LOGISTICS_POLL_LEASE_SECONDS=120
LOGISTICS_TRACK_MAX_CONSECUTIVE_FAILURES=5
LOGISTICS_STALE_DELIVERY_DAYS=30
LOGISTICS_RAW_TRACK_RETENTION_DAYS=30
CARRIER_4PX_ENABLED=false
CARRIER_4PX_WEBHOOK_SECRET=
CARRIER_4PX_API_KEY=
CARRIER_YUN_ENABLED=false
CARRIER_YUN_WEBHOOK_SECRET=
CARRIER_YUN_API_KEY=
CARRIER_17TRACK_ENABLED=false
CARRIER_17TRACK_WEBHOOK_SECRET=
CARRIER_17TRACK_API_KEY=

# ===== Order and Stripe =====
ORDER_PAYMENT_TIMEOUT_MINUTES=15
ORDER_IDEMPOTENCY_TTL=600
ORDER_STREAM_MAX_LEN=10000
ORDER_OUTBOX_MAX_ATTEMPTS=5
ORDER_OUTBOX_ACK_SLA=300
ORDER_OUTBOX_RETENTION_DAYS=7
ORDER_SINGLE_SKU_LIMIT=99
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
