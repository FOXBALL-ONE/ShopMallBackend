# 启用后每次启动都会删除现有 SQLite 数据库并重新初始化（不兼容、不保留任何数据）。
TEMPLATE_DATABASE_INITIALIZATION_ENABLED=false
# 首次启动时创建的第一个用户。用户修改密码后，后续启动不会覆盖数据库中的密码。
TEMPLATE_INITIAL_USERNAME=admin
TEMPLATE_INITIAL_PASSWORD=change-me-now
# 文件存储根目录。相对路径以 TemplateGeneration 进程工作目录为基准。
TEMPLATE_STORAGE_BASE_PATH=storage
# 设为 false 时不启动后台图生图 Worker，仅保留任务查询与管理接口。
TEMPLATE_GENERATION_WORKER_ENABLED=true
# Nitro 内部图生图 Worker 的并发任务数。每个任务通过提交批次时选定的提供商和模型执行。
TEMPLATE_GENERATION_WORKER_CONCURRENCY=2
# Worker 领取任务后的租约时长（毫秒）。进程异常退出后，租约过期的任务可被重新领取。
TEMPLATE_GENERATION_LEASE_MS=180000
# 单次 OpenAI 图像请求的超时时间（毫秒）。
TEMPLATE_GENERATION_TIMEOUT_MS=300000
